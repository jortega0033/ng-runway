{
  "name": "ng-runway",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tokens:build": "node scripts/tokens-build.mjs",
    "tokens:check": "node scripts/tokens-build.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "hooks:install": "husky",
    "cli:test": "node --test \"cli/**/*.test.mjs\"",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "serve:dist": "node scripts/serve-dist.mjs",
    "docs:components": "node scripts/build-components-doc.mjs",
    "gen:feature": "node scripts/gen-feature.mjs",
    "verify": "npm run tokens:check && npm run lint && npm run format:check && npm run typecheck && npm test -- --watch=false && npm run build && npm run e2e"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "devDependencies": {
    "@angular/aria": "^22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@faker-js/faker": "^10.6.0",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/signals": "^22.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/angular": "^19.6.0",
    "angular-eslint": "^22.6.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.4",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "description": "Angular 22 admin dashboard boilerplate for workforce management",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jortega0033/ng-runway.git"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mjs,yml,yaml}": [
      "prettier --write"
    ]
  },
  "bin": {
    "ng-runway": "cli/index.mjs"
  }
}
