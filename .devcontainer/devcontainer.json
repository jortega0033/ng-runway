{
  "name": "ng-runway",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [4200],
  "postCreateCommand": "npm ci --ignore-scripts && npm run hooks:install",
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
